# Firebase web app config (Project settings → Your apps → SDK setup and configuration).
# These values are not secrets — a Firebase web key identifies the project, it does not grant
# access. What protects the data are the Firestore/Storage security rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — Google Maps JavaScript API key. Without it the client map shows a notice instead of
# rendering; every other screen works. Restrict the key by HTTP referrer before shipping it.
VITE_GOOGLE_MAPS_API_KEY=

# Only used by `npm run seed:demo` — the demo account the seed signs in as.
# Never point this at a production project.
SEED_EMAIL=demo@marnystock.app
SEED_PASSWORD=demo1234
